# 智研 AI 助手环境变量模板
# 复制为 .env 后填入真实值
PROJECT_NAME="智研 AI 助手"
DEBUG=false
LOG_LEVEL=INFO

# OpenAI 兼容 API Key（用于后续 LLM 调用）
OPENAI_API_KEY=sk-your-openai-api-key

# 默认模型
DEFAULT_MODEL=gpt-4o-mini

# MCP Server（day022，SSE 传输模式下生效）
MCP_TRANSPORT=sse
MCP_HOST=0.0.0.0
MCP_PORT=8000

# Embedding 选型（day041）：mock / char-ngram / sentence-transformer / ollama / openai
EMBEDDING_PROVIDER=char-ngram
# sentence-transformer 提供方使用的本地模型名
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
# openai 提供方使用的云端 embedding 模型名
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# 语义缓存（day043）：相似度命中阈值（0~1）与最大缓存条目数
CACHE_SIMILARITY_THRESHOLD=0.85
CACHE_MAX_SIZE=128

# 本地模型部署（day045）
# LLM 后端选型：cloud（云端 OpenAI 兼容，默认）/ local（本机推理服务）
LLM_BACKEND=cloud
# 本地后端：ollama（默认端口 11434）/ vllm（默认端口 8000）
LOCAL_BACKEND=ollama
# 本地模型名，须与 `ollama list` 输出一致
LOCAL_MODEL=qwen3:8b
# 本地 OpenAI 兼容端点（漏写 /v1 会被自动补齐）
LOCAL_BASE_URL=http://localhost:11434/v1
# 本地服务占位密钥：Ollama 不校验；vLLM 需与 --api-key 一致（未启用则任意非空值）
LOCAL_API_KEY=ollama
# 上下文窗口：对齐 Ollama 默认 4096（等价于 OLLAMA_CONTEXT_LENGTH）
LOCAL_CONTEXT_LENGTH=4096
# 模型空闲常驻时长：5m（默认）/ -1（常驻不卸载）/ 0（用完即卸）
LOCAL_KEEP_ALIVE=5m
# 本地视觉模型（qwen3-vl 系列）才置 true
LOCAL_SUPPORTS_VISION=false
# 本地 embedding 模型（nomic-embed-text 为 768 维）
LOCAL_EMBEDDING_MODEL=nomic-embed-text

# 一体化流水线（day046）：把 prompt/路由/缓存/成本/安全串成一条调用链
# 是否启用语义缓存阶段（关闭后每次请求都真实调用 LLM）
PIPELINE_CACHE_ENABLED=true
# 输入侧护栏命中注入时是否直接拒答（false 则只记录不拦截，适合灰度观测）
PIPELINE_BLOCK_ON_INJECTION=true

# 性能基线（day046）：参考基线文件路径与回归容忍度（当前值/基线值的倍数上限）
PERF_BASELINE_PATH=data/eval/perf_baseline.json
PERF_LATENCY_TOLERANCE=1.5
PERF_TOKEN_TOLERANCE=1.2
PERF_COST_TOLERANCE=1.2

# 微调数据工程（M5-D1）：种子数据目录、清洗阈值与切分参数
# 种子样本与落盘产物所在目录（相对进程工作目录）
FINETUNE_DATA_DIR=data/finetune
# 手写种子样本文件路径
FINETUNE_SEED_PATH=data/finetune/seed_examples.jsonl
# 清洗规则：输出短于/长于该字符数即判为不合格
FINETUNE_MIN_OUTPUT_CHARS=8
FINETUNE_MAX_OUTPUT_CHARS=4000
# 清洗规则：指令超过该字符数不放入训练集（需单独评测长上下文）
FINETUNE_MAX_INSTRUCTION_CHARS=1000
# 训练/评估切分比例（评估集占比）与随机种子
FINETUNE_EVAL_RATIO=0.2
FINETUNE_SPLIT_SEED=42

# SFT 监督微调（M5-D2）：以下九个默认值按「参考模型 + 本课程数据集」标定
# 换成真实的 7B 全参训练时，学习率与批大小必须重新标定（学习率没有绝对尺度）
# 训练产物目录（检查点写在它下面的 checkpoint-{step} / final）
SFT_OUTPUT_DIR=outputs/sft
# 单条样本最大 token 数：由渲染后的长度分位数决定（本数据集 p100=320）
SFT_MAX_LENGTH=384
SFT_NUM_TRAIN_EPOCHS=10.0
SFT_LEARNING_RATE=8.0
SFT_PER_DEVICE_TRAIN_BATCH_SIZE=2
SFT_GRADIENT_ACCUMULATION_STEPS=4
SFT_WARMUP_RATIO=0.03
SFT_LR_SCHEDULER_TYPE=cosine
SFT_SEED=42
