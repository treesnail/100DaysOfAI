# 智研 AI 助手环境变量模板
# 复制为 .env 后填入真实值
PROJECT_NAME="智研 AI 助手"
DEBUG=false
LOG_LEVEL=INFO

# OpenAI 兼容 API Key（用于后续 LLM 调用）
OPENAI_API_KEY=sk-your-openai-api-key

# 默认模型
DEFAULT_MODEL=gpt-4o-mini

# MCP Server（day022，SSE 传输模式下生效）
MCP_TRANSPORT=sse
MCP_HOST=0.0.0.0
MCP_PORT=8000

# Embedding 选型（day041）：mock / char-ngram / sentence-transformer / ollama / openai
EMBEDDING_PROVIDER=char-ngram
# sentence-transformer 提供方使用的本地模型名
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
# openai 提供方使用的云端 embedding 模型名
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# 语义缓存（day043）：相似度命中阈值（0~1）与最大缓存条目数
CACHE_SIMILARITY_THRESHOLD=0.85
CACHE_MAX_SIZE=128

# 本地模型部署（day045）
# LLM 后端选型：cloud（云端 OpenAI 兼容，默认）/ local（本机推理服务）
LLM_BACKEND=cloud
# 本地后端：ollama（默认端口 11434）/ vllm（默认端口 8000）
LOCAL_BACKEND=ollama
# 本地模型名，须与 `ollama list` 输出一致
LOCAL_MODEL=qwen3:8b
# 本地 OpenAI 兼容端点（漏写 /v1 会被自动补齐）
LOCAL_BASE_URL=http://localhost:11434/v1
# 本地服务占位密钥：Ollama 不校验；vLLM 需与 --api-key 一致（未启用则任意非空值）
LOCAL_API_KEY=ollama
# 上下文窗口：对齐 Ollama 默认 4096（等价于 OLLAMA_CONTEXT_LENGTH）
LOCAL_CONTEXT_LENGTH=4096
# 模型空闲常驻时长：5m（默认）/ -1（常驻不卸载）/ 0（用完即卸）
LOCAL_KEEP_ALIVE=5m
# 本地视觉模型（qwen3-vl 系列）才置 true
LOCAL_SUPPORTS_VISION=false
# 本地 embedding 模型（nomic-embed-text 为 768 维）
LOCAL_EMBEDDING_MODEL=nomic-embed-text
