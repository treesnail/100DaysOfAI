# 智研 AI 助手环境变量模板
# 复制为 .env 后填入真实值
PROJECT_NAME="智研 AI 助手"
DEBUG=false
LOG_LEVEL=INFO

# OpenAI 兼容 API Key（用于后续 LLM 调用）
OPENAI_API_KEY=sk-your-openai-api-key

# 默认模型
DEFAULT_MODEL=gpt-4o-mini

# MCP Server（day022，SSE 传输模式下生效）
MCP_TRANSPORT=sse
MCP_HOST=0.0.0.0
MCP_PORT=8000

# Embedding 选型（day041）：mock / char-ngram / sentence-transformer / openai
EMBEDDING_PROVIDER=char-ngram
# sentence-transformer 提供方使用的本地模型名
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
# openai 提供方使用的云端 embedding 模型名
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# 语义缓存（day043）：相似度命中阈值（0~1）与最大缓存条目数
CACHE_SIMILARITY_THRESHOLD=0.85
CACHE_MAX_SIZE=128
